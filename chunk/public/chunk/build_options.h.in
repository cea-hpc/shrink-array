#pragma once

// GENERATED by CMake (chunk/CMakeLists.txt) from chunk/build_options.h.in:
// the options this chunk library was built with. Installed with it.
//
// The headers read their configuration from here, never from the command line
// of the file that includes them: a program compiles the library's headers
// exactly as the library did, whatever it defines itself. What a header cannot
// adapt to -- OpenMP, which the compiler decides -- is checked below and
// refused with a message. The per-library settings (variant, chunk size,
// dynamic geometry) come with the CMake target; a program that spells them
// differently from the library it links does not link
// (chunk/internal/link_check.h).

// clang-format off
#define CHUNK_OPT_OPENMP                   @CHUNK_OPT_OPENMP@
#define CHUNK_OPT_THREADED                 @CHUNK_OPT_THREADED@
#define CHUNK_OPT_STD_THREADS                     @CHUNK_OPT_STD_THREADS@
#define CHUNK_OPT_STD_ALLOC                @CHUNK_OPT_STD_ALLOC@
#define CHUNK_OPT_FAST_ALLOC               @CHUNK_OPT_FAST_ALLOC@
#define CHUNK_OPT_OMPT                     @CHUNK_OPT_OMPT@
#define CHUNK_OPT_DEBUG                    @CHUNK_OPT_DEBUG@
#define CHUNK_OPT_CHECK_OPTIM              @CHUNK_OPT_CHECK_OPTIM@
#define CHUNK_OPT_STATS                    @CHUNK_OPT_STATS@
#define CHUNK_OPT_MM_PROTECT               @CHUNK_OPT_MM_PROTECT@
#define CHUNK_OPT_SECOND_VALUE_INDEXED     @CHUNK_OPT_SECOND_VALUE_INDEXED@
#define CHUNK_OPT_RECLAIM_EMPTY_SLABS      @CHUNK_OPT_RECLAIM_EMPTY_SLABS@
#define CHUNK_OPT_AGGRESSIVE_COMPRESSION   @CHUNK_OPT_AGGRESSIVE_COMPRESSION@
#define CHUNK_OPT_DEFERRED_DRAIN_THRESHOLD @CHUNK_OPT_DEFERRED_DRAIN_THRESHOLD@
#define CHUNK_OPT_FORCE_DEFER_EVERY        @CHUNK_OPT_FORCE_DEFER_EVERY@
#define CHUNK_OPT_POOL_NO_REUSE            @CHUNK_OPT_POOL_NO_REUSE@
#define CHUNK_OPT_ALIGN_CHECK              @CHUNK_OPT_ALIGN_CHECK@
#define CHUNK_OPT_FORCE_LEDGER             @CHUNK_OPT_FORCE_LEDGER@
#define CHUNK_OPT_TEST_HOOKS               @CHUNK_OPT_TEST_HOOKS@
#define CHUNK_OPT_DO_CHECK                 @CHUNK_OPT_DO_CHECK@
#define CHUNK_OPT_RECHUNK_LEDGERTRACE      @CHUNK_OPT_RECHUNK_LEDGERTRACE@
#define CHUNK_OPT_RING_LOG_DEBUG           @CHUNK_OPT_RING_LOG_DEBUG@
#define CHUNK_OPT_RING_LOG_OP              @CHUNK_OPT_RING_LOG_OP@
// clang-format on

#if CHUNK_OPT_OPENMP && !defined(_OPENMP)
    #error "the chunk library was built with OpenMP: compile this file with OpenMP as well (-fopenmp, -fiopenmp, -mp), or link a library built without it"
#elif !CHUNK_OPT_OPENMP && defined(_OPENMP)
    #error "the chunk library was built without OpenMP: compile this file without OpenMP, or link a library built with it"
#endif

#if CHUNK_OPT_STD_THREADS && !(defined(FAST_ALLOC_PMP_STD) && FAST_ALLOC_PMP_STD)
    #error "the chunk library was built with the std backend (CHUNK_THREADS=std): compile this file with -DFAST_ALLOC_PMP_STD=1 (the chunk:: targets add it)"
#elif !CHUNK_OPT_STD_THREADS && defined(FAST_ALLOC_PMP_STD) && FAST_ALLOC_PMP_STD
    #error "the chunk library was built without the std backend: compile this file without FAST_ALLOC_PMP_STD"
#endif
