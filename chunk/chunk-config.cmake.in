include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CHUNK_OMP@)
  find_dependency(OpenMP)
endif()
if(NOT @CHUNK_STD_ALLOC@)
  find_dependency(fast_allocators @CHUNK_FAST_ALLOCATORS_VERSION@)
endif()

@PACKAGE_INIT@

# The package is shrink_array since 0.3: find_package(shrink_array), targets
# shrink_array::zero_any (for chunk::chunk_zero_any), ... This name goes at the
# next minor version.
if(NOT _shrink_array_loads_chunk)
  message(DEPRECATION "find_package(chunk) is find_package(shrink_array) now: shrink_array::zero_any for chunk::chunk_zero_any, shrink_array_STATIC_SIZES for chunk_STATIC_SIZES, ...")
endif()

# What this installation holds, for a consumer that wants to choose:
#   chunk_STATIC_SIZES  the compile-time sizes built (chunk::chunk_zero_any_<size>)
#   chunk_DEFAULT_SIZE  the size of the bare chunk::chunk_zero / _zero_or_value / _zero_any
#   chunk_HAS_DYN       chunk::chunk_<variant>_dyn exist (runtime chunk size)
#   chunk_OPENMP        built with OpenMP (consumers are compiled with it too)
#   chunk_THREADS       the threading backend: openmp, std or serial
#   chunk_OMPT          built with the OMPT tool (no phase brackets needed)
#   chunk_STD_ALLOC     chunk buffers from the standard allocator
set(chunk_STATIC_SIZES "@CHUNK_STATIC_SIZES@")
set(chunk_DEFAULT_SIZE "@CHUNK_DEFAULT_SIZE@")
set(chunk_HAS_DYN "@CHUNK_BUILD_DYN@")
set(chunk_OPENMP "@CHUNK_OMP@")
set(chunk_THREADS "@CHUNK_THREADS_BACKEND@")
set(chunk_OMPT "@CHUNK_HAVE_OMPT@")
set(chunk_STD_ALLOC "@CHUNK_STD_ALLOC@")

include("${CMAKE_CURRENT_LIST_DIR}/chunk-targets.cmake")

# zero_or_value was zero_one_value until 0.3: the former names of its targets,
# each linking the new one, with a message when a project links it.
foreach(_chunk_former IN ITEMS "" "_dyn" _@_chunk_static_suffixes@)
  if(TARGET chunk::chunk_zero_or_value${_chunk_former} AND NOT TARGET chunk::chunk_zero_one_value${_chunk_former})
    add_library(chunk::chunk_zero_one_value${_chunk_former} INTERFACE IMPORTED)
    set_target_properties(chunk::chunk_zero_one_value${_chunk_former} PROPERTIES
                          INTERFACE_LINK_LIBRARIES chunk::chunk_zero_or_value${_chunk_former}
                          DEPRECATION "renamed chunk::chunk_zero_or_value${_chunk_former}")
  endif()
endforeach()
unset(_chunk_former)

check_required_components(chunk)
