# ============================================================================
# Script mode (cmake -P), run by the build: writes the build stamp.
#   -DSRC=<source dir> -DLIST=<files.txt, one relative path per line>
#   -DOUT_CPP=<generated .cpp> -DOUT_TXT=<build_stamp.txt> -DGIT=<git or empty>
# Each output is replaced only when its content changes. See
# shrink_build_stamp.cmake for what the stamp is for.
# ============================================================================

# --- Source fingerprint: SHA1 over "relative-path sha1(content)" lines --------
file(STRINGS "${LIST}" _files)
set(_acc "")
set(_n 0)
foreach(_r IN LISTS _files)
  if(_r STREQUAL "")
    continue()
  endif()
  if(EXISTS "${SRC}/${_r}")
    file(SHA1 "${SRC}/${_r}" _h)
  else()
    set(_h "missing")
  endif()
  string(APPEND _acc "${_r} ${_h}\n")
  math(EXPR _n "${_n} + 1")
endforeach()
string(SHA1 _fp "${_acc}")
string(SUBSTRING "${_fp}" 0 12 _fp)

# --- git describe ---------------------------------------------------------------
set(_git "none")
if(GIT AND EXISTS "${SRC}/.git")
  execute_process(COMMAND "${GIT}" -C "${SRC}" describe --always --dirty --abbrev=10
                  OUTPUT_VARIABLE _out
                  RESULT_VARIABLE _rc
                  OUTPUT_STRIP_TRAILING_WHITESPACE
                  ERROR_QUIET)
  if(_rc EQUAL 0 AND NOT _out STREQUAL "")
    set(_git "${_out}")
  endif()
endif()

set(_stamp "git=${_git} src=${_fp}")

# --- Outputs, replaced only when they change --------------------------------------
function(_write_if_changed path content)
  if(EXISTS "${path}")
    file(READ "${path}" _old)
    if(_old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

_write_if_changed("${OUT_TXT}" "${_stamp} files=${_n}\n")

_write_if_changed("${OUT_CPP}" "// Generated by cmake/shrink_build_stamp_gen.cmake -- do not edit.
#include <cstdio>

extern \"C\" const char* shrink_build_stamp()
{
    return \"${_stamp}\";
}

// Before main() and before the default-priority static initialisers (65535),
// some of which print: the first line of every stamped executable's output.
__attribute__((constructor(101))) static void print_build_stamp_at_startup()
{
    std::printf(\"[build] %s\\n\", shrink_build_stamp());
    std::fflush(stdout);
}
")
