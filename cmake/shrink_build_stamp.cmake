# ============================================================================
# Build stamp and `check` target.
#
# Build stamp: every executable that carries a ctest of label `validation`
# prints, before main(), one line
#
#     [build] git=<git describe --always --dirty> src=<fingerprint>
#
# `src` is a SHA1 (12 hex) over the relative path and content of every source
# that goes into the binaries (chunk/, fast_allocators/, examples/,
# third_party/, cmake/, the top CMakeLists.txt). Two trees -- the laptop and
# the cluster -- give the same `src` exactly when those files are identical,
# git or not (a tree synchronised by CLion's deployment has the same HEAD on
# both sides and says nothing through `git describe`). The same line is
# written to <build>/build_stamp.txt.
#
# The stamp is regenerated by the build only when one of those sources
# changes (or HEAD moves); the generated .cpp is replaced only if its content
# differs, so an unchanged tree recompiles and relinks nothing.
#
# `check`: builds every executable of those directories, then runs
# `ctest -L validation --output-on-failure -j ${CHUNK_CHECK_JOBS}`. A bare
# `ctest` rebuilds nothing: a binary older than its source is tested as is.
#
# Usage: include() this file before add_subdirectory(examples); call
# shrink_stamp_directory_targets() at the end of each directory that
# registers validation tests; call shrink_add_check_target() after
# add_subdirectory(examples).
# ============================================================================

set(_shrink_stamp_dir "${CMAKE_BINARY_DIR}/generated/build_stamp")
file(MAKE_DIRECTORY "${_shrink_stamp_dir}")

# --- The fingerprinted sources ----------------------------------------------
set(_shrink_stamp_globs "")
foreach(_d chunk fast_allocators examples third_party cmake)
  foreach(_e h hpp cpp cc c inc cmake)
    list(APPEND _shrink_stamp_globs "${PROJECT_SOURCE_DIR}/${_d}/*.${_e}")
  endforeach()
  # CMakeLists.txt only: a run leaves other .txt files behind (memory_mo.txt...)
  list(APPEND _shrink_stamp_globs "${PROJECT_SOURCE_DIR}/${_d}/CMakeLists.txt")
endforeach()
# CONFIGURE_DEPENDS: a file added or removed re-runs the glob at build time.
file(GLOB_RECURSE _shrink_stamp_abs CONFIGURE_DEPENDS LIST_DIRECTORIES false ${_shrink_stamp_globs})
list(APPEND _shrink_stamp_abs "${PROJECT_SOURCE_DIR}/CMakeLists.txt")
list(REMOVE_DUPLICATES _shrink_stamp_abs)
list(SORT _shrink_stamp_abs)

set(_shrink_stamp_rel "")
foreach(_f IN LISTS _shrink_stamp_abs)
  file(RELATIVE_PATH _r "${PROJECT_SOURCE_DIR}" "${_f}")
  list(APPEND _shrink_stamp_rel "${_r}")
endforeach()
string(REPLACE ";" "\n" _shrink_stamp_rel_txt "${_shrink_stamp_rel}")
# Rewritten only when the list changes: it is a dependency of the stamp.
set(_shrink_stamp_list "${_shrink_stamp_dir}/files.txt")
file(WRITE "${_shrink_stamp_list}.tmp" "${_shrink_stamp_rel_txt}\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
                        "${_shrink_stamp_list}.tmp" "${_shrink_stamp_list}")
file(REMOVE "${_shrink_stamp_list}.tmp")

# --- git: HEAD moving (commit, checkout, reset) re-runs the stamp too --------
# The cluster's modules export GIT_ROOT (the git install): honouring it as a
# hint is right, and silences CMP0144 (CMake >= 3.27). include() scopes it.
if(POLICY CMP0144)
  cmake_policy(SET CMP0144 NEW)
endif()
find_package(Git QUIET)
set(_shrink_stamp_git_deps "")
if(GIT_FOUND AND IS_DIRECTORY "${PROJECT_SOURCE_DIR}/.git")
  foreach(_g HEAD logs/HEAD)
    if(EXISTS "${PROJECT_SOURCE_DIR}/.git/${_g}")
      list(APPEND _shrink_stamp_git_deps "${PROJECT_SOURCE_DIR}/.git/${_g}")
    endif()
  endforeach()
endif()

# --- The generation step ------------------------------------------------------
# OUTPUT is a sentinel touched on every run; the .cpp and the .txt are
# BYPRODUCTS replaced only when their content changes (Ninja restats them),
# so nothing downstream rebuilds when the tree is unchanged.
set(_shrink_stamp_cpp "${_shrink_stamp_dir}/build_stamp.cpp")
add_custom_command(
  OUTPUT "${_shrink_stamp_dir}/build_stamp.sentinel"
  BYPRODUCTS "${_shrink_stamp_cpp}" "${CMAKE_BINARY_DIR}/build_stamp.txt"
  COMMAND ${CMAKE_COMMAND}
          "-DSRC=${PROJECT_SOURCE_DIR}"
          "-DLIST=${_shrink_stamp_list}"
          "-DOUT_CPP=${_shrink_stamp_cpp}"
          "-DOUT_TXT=${CMAKE_BINARY_DIR}/build_stamp.txt"
          "-DGIT=${GIT_EXECUTABLE}"
          -P "${PROJECT_SOURCE_DIR}/cmake/shrink_build_stamp_gen.cmake"
  COMMAND ${CMAKE_COMMAND} -E touch "${_shrink_stamp_dir}/build_stamp.sentinel"
  DEPENDS ${_shrink_stamp_abs} ${_shrink_stamp_git_deps}
          "${_shrink_stamp_list}"
          "${PROJECT_SOURCE_DIR}/cmake/shrink_build_stamp_gen.cmake"
  COMMENT "Build stamp (git describe + source fingerprint)"
  VERBATIM)
add_custom_target(shrink_build_stamp_gen
  DEPENDS "${_shrink_stamp_dir}/build_stamp.sentinel")

# A placeholder so that the first configure has a file to compile.
if(NOT EXISTS "${_shrink_stamp_cpp}")
  file(WRITE "${_shrink_stamp_cpp}"
       "extern \"C\" const char* shrink_build_stamp() { return \"git=? src=?\"; }\n")
endif()

add_library(shrink_build_stamp OBJECT "${_shrink_stamp_cpp}")
add_dependencies(shrink_build_stamp shrink_build_stamp_gen)

# --- Per-directory hook ---------------------------------------------------------
# Links the stamp into every executable of the CALLING directory (same
# directory as the targets: no cross-directory policy involved) and records
# them as dependencies of `check`.
function(shrink_stamp_directory_targets)
  get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_t IN LISTS _targets)
    get_target_property(_type ${_t} TYPE)
    if(_type STREQUAL "EXECUTABLE")
      target_sources(${_t} PRIVATE $<TARGET_OBJECTS:shrink_build_stamp>)
      add_dependencies(${_t} shrink_build_stamp)
      set_property(GLOBAL APPEND PROPERTY SHRINK_CHECK_TARGETS ${_t})
    endif()
  endforeach()
endfunction()

# --- `check` ------------------------------------------------------------------
set(CHUNK_CHECK_JOBS 4 CACHE STRING "ctest -j for the `check` target")

function(shrink_add_check_target)
  get_property(_deps GLOBAL PROPERTY SHRINK_CHECK_TARGETS)
  add_custom_target(check
    COMMAND ${CMAKE_COMMAND} -E cat "${CMAKE_BINARY_DIR}/build_stamp.txt"
    COMMAND ${CMAKE_CTEST_COMMAND} -L validation --output-on-failure -j ${CHUNK_CHECK_JOBS}
    WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
    COMMENT "Build the validation executables, then ctest -L validation"
    USES_TERMINAL
    VERBATIM)
  if(_deps)
    add_dependencies(check ${_deps})
  endif()
endfunction()
