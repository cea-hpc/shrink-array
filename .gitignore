cmake-*/
build*/
.idea/

*.o
*.a
*.so
*~
.aider*
*.tofus

# --- What the binaries leave behind when they are run from the source tree ---
# The bench and its harnesses write these relative to their CWD: memory_mo.txt
# (bench_utils.cpp), seed<iter_max>.txt (the pinned RNG seed, shrink_bench.cpp),
# data_tab* (the reference oracle), print.txt / info.txt (ad-hoc dumps), which
# runs launched from python/ or from the repository root would leave in
# `git status`. bench_and_test.py's --output-dir and
# multi_launch_stress.py's --run-dir put them elsewhere; this is the
# safety net for a binary started by hand.
memory_mo.txt
seed*.txt
data_tab*
print.txt
info.txt

# Sanitizer / tooling logs of a run done by hand.
*.log
iwyu.log

# Archives of a build tree or of a bug report, kept next to the sources.
*.zip

# Python bytecode of the scripts in python/.
__pycache__/
*.pyc

# The one-shot apply_*.py patch scripts: written for a single edit, never meant
# to be part of the tree (git log has the result, which is what matters).
apply_*.py

# ShAIrLock: opencode install dir (binaries, token, logs)
.shairlock/opencode/

# ShAIrLock: session vault backup
.git_vault/

# Build-slot token dirs of scripts/functions_for_compile.sh (__slot_dir), left
# behind when build_rep is the source tree.
.build-slots.*/

# Editor / patch fossils (backups and one-shot fix scripts): never part of the tree.
*.bak*
fix_*.py

# --- Doxygen output (cd docs && doxygen) ---
docs/html/
docs/doxygen-warnings.log
