#pragma once

// GENERATED by CMake (fast_allocators/CMakeLists.txt) from
// fast_allocators/build_options.h.in: the options this fast_allocators library
// was built with. Installed with it. The headers read their configuration from
// here, never from the command line of the file that includes them, and refuse
// a file whose OpenMP setting differs from the library's.

// clang-format off
#define FAST_ALLOC_OPT_OPENMP              @FAST_ALLOC_OPT_OPENMP@
#define FAST_ALLOC_OPT_THREADED            @FAST_ALLOC_OPT_THREADED@
#define FAST_ALLOC_OPT_DEBUG               @FAST_ALLOC_OPT_DEBUG@
#define FAST_ALLOC_OPT_CHECK_LISTS         @FAST_ALLOC_OPT_CHECK_LISTS@
#define FAST_ALLOC_OPT_RECLAIM_EMPTY_SLABS @FAST_ALLOC_OPT_RECLAIM_EMPTY_SLABS@
// clang-format on

#if FAST_ALLOC_OPT_OPENMP && !defined(_OPENMP)
    #error "the fast_allocators library was built with OpenMP: compile this file with OpenMP as well, or link a library built without it"
#elif !FAST_ALLOC_OPT_OPENMP && defined(_OPENMP)
    #error "the fast_allocators library was built without OpenMP: compile this file without OpenMP, or link a library built with it"
#endif
