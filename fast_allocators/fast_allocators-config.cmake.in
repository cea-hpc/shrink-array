include(CMakeFindDependencyMacro)
# Threads::Threads: in the exported target's link interface with the std
# backend (CHUNK_THREADS=std); found always, as chunk-config.cmake does, so a
# project that finds fast_allocators alone has it.
find_dependency(Threads)
if(@ALLOCATORS_OMP@)
  find_dependency(OpenMP)
endif()

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/fast_allocators-targets.cmake")

check_required_components(fast_allocators)
