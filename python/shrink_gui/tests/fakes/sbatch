#!/bin/bash
# Fake sbatch (a plain Slurm site, sites/slurm_example.toml): as the fake
# ccc_msub, from "#SBATCH --output=" and the "#SBATCH --dependency=" /
# "#SBATCH --begin=" lines; prints Slurm's "Submitted batch job <id>".
job="$1"; out=$(sed -n 's/^#SBATCH --output=//p' "$job" | head -1)
E=$(grep '^#SBATCH --\(dependency\|begin\)=' "$job")
dep=$(grep -o 'after\(ok\|any\):[0-9]*' <<< "$E")
begin=$(grep -o 'begin=now+[0-9]*' <<< "$E" | cut -d+ -f2)
setsid bash -c '
    job=$1 dep=$2 begin=$3
    if [ -n "$dep$begin" ]; then
        touch "$FAKE_Q/pending_$$"
        if [ -n "$dep" ]; then
            j=${dep#*:}
            while kill -0 "$j" 2>/dev/null; do sleep 0.2; done
            if [ "${dep%%:*}" = afterok ]; then
                d=$(cat "$FAKE_Q/dir_$j" 2>/dev/null)
                [ "$(cat "$d/exit_code" 2>/dev/null)" = 0 ] || while :; do sleep 1; done
            fi
        fi
        [ -n "$begin" ] && sleep "$begin"
        rm -f "$FAKE_Q/pending_$$"
    fi
    exec bash "$job"' fake_job "$job" "$dep" "$begin" > "$out" 2>&1 < /dev/null &
id=$!; echo "$id" > "$FAKE_Q/$id"
sed -n 's/^D=//p' "$job" | head -1 > "$FAKE_Q/dir_$id"
echo "Submitted batch job $id"
